a-type": "text"}, ["span", {"data-type": "leaf"}, "2N"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52nunk8x8ab8cb"}, ["p", {"uuid": "mv15e52no59fko55s2"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "7 × 15000 = 105,000 元"]]]]], ["tr", {"uuid": "mv15e52n807763ml5gi"}, ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52ne0hu512gv7n"}, ["p", {"uuid": "mv15e52ncj0giablwy"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "加：年终奖折算"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52namr25eiha77"}, ["p", {"uuid": "mv15e52ng794tdh4vpp"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "按在职月份"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52nisn92yeoeo"}, ["p", {"uuid": "mv15e52nrcgyfb27wts"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "约 5,000-15,000 元"]]]]], ["tr", {"uuid": "mv15e52nv1862kvrkji"}, ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52nv7hzasdardn"}, ["p", {"uuid": "mv15e52nutslwccykji"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "加：未休年假 5 天"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52n6e5nfa2e8ct"}, ["p", {"uuid": "mv15e52n1qji0z7eucs"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "200% 日薪"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52n18m4m88by8mj"}, ["p", {"uuid": "mv15e52n5cvp57cccda"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "约 6,900 元"]]]]], ["tr", {"uuid": "mv15e52nl3ej7s4fqwj"}, ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52nl7ts7gdbh3p"}, ["p", {"uuid": "mv15e52n7g7z8qe93bo"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "加：欠发加班费"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52nv8neeofdn4o"}, ["p", {"uuid": "mv15e52n39107d0ioys"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "看证据"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52njwcomoxwvi"}, ["p", {"uuid": "mv15e52nrri87shsq0i"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "几千到几万不等"]]]]], ["tr", {"uuid": "mv15e52nlffjojzvt29"}, ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52ntnc8s2c6qzn"}, ["p", {"uuid": "mv15e52nbqyspvademq"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "加：失业金"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52nxeoqt4c4us"}, ["p", {"uuid": "mv15e52n7ud631vz4sq"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "24 个月内"]]]], ["tc", {"rowSpan": 1, "colSpan": 1, "uuid": "mv15e52np8w03n6jsdl"}, ["p", {"uuid": "mv15e52n75b9i45qh9s"}, ["span", {"data-type": "text"}, ["span", {"data-type": "leaf"}, "按参保地标准，无全国统一金额"]]]]]], ["p", {"blockquote": true, "uuid": "mv0m31idjhs7k1jpsb"}, ["span", {"data-type": "text"}, ["span", {"bold": true, "data-type": "leaf"}, "记住：谈赔偿是谈判，不是判决。"], ["span", {"data-type": "leaf"}, " 公司开价低，你就往上谈；开价比法定高，见好就收。关键是先搞清楚法定底线在哪，再决定要不要、要多少。"]]], ["p", {"blockquote": true, "uuid": "mv0tmauwbb8nrayy9j"}, ["span", {"data-type": "text"}, ["span", {"bold": true, "data-type": "leaf"}, "本章小结："], ["span", {"data-type": "leaf"}, " 被裁后能拿多少钱，取决于解除性质、工资基数、工作年限和证据。先按情形判断该拿 N、N+1 还是 2N：工作每满一年算一个月工资，满 6 个月不满一年按一年算，不满 6 个月算半个月；月工资超过当地上年度职工月平均工资 3 倍的按 3 倍封顶。签协议前把赔偿金额、支付时间和离职原因三项写清楚，离职原因不写个人原因。除补偿外，年终奖、提成、未休年假和其他欠款一并结清。协商不成，在离职一年内申请劳动仲裁，仲裁不收费。"]]]]